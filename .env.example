# ==============================================================================
# SATRIA SENTINEL — Environment Configuration Template (Phase 1)
# Copy this file to `.env` before running locally or via Docker Compose.
# DO NOT commit real credentials or secrets to version control.
# ==============================================================================

# --- Project Metadata ---
PROJECT_NAME="SATRIA SENTINEL"
ENVIRONMENT="development"
APP_VERSION="0.1.0"
LOG_LEVEL="INFO"

# --- PostgreSQL Database ---
POSTGRES_USER="satria_dev"
POSTGRES_PASSWORD="CHANGE_ME_LOCAL_DEV_PASSWORD"
POSTGRES_DB="satria_sentinel_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# Backend SQLAlchemy Database URL (override host to `db` inside Docker Compose)
DATABASE_URL="postgresql+psycopg://satria_dev:CHANGE_ME_LOCAL_DEV_PASSWORD@localhost:5432/satria_sentinel_db"

# --- Backend API Configuration ---
API_V1_PREFIX="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT="8000"
# Comma-separated list of allowed CORS origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Authentication & Security Configuration (Phase 2) ---
JWT_SECRET_KEY="CHANGE_ME_JWT_SECRET_KEY_MIN_32_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="120"
MAX_UPLOAD_SIZE_BYTES="2097152"

# --- Frontend Configuration ---
NEXT_PUBLIC_APP_NAME="SATRIA SENTINEL"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
